# Copy to .env and fill in. Never commit .env.
# Only NEXT_PUBLIC_* values reach the browser. Keep secrets out of them.

# ── Database (Neon) ─────────────────────────────────────────────
# Neon dashboard → Connect → Prisma. Pooled URL has "-pooler" in the host.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── UPI ─────────────────────────────────────────────────────────
UPI_ID="trustname@bank"
# Name exactly as in the bank's own QR (pn=...).
UPI_NAME="NAMO BHAGWATE VASUDEVAYA TRUST"
# Merchant category code from the bank's QR (mc=...). Leave empty for a personal UPI ID.
UPI_MCC=
# Shown under the UPI ID on the payment card, e.g. "Current account • 0330".
UPI_ACCOUNT_LABEL=
# Adds tr=<donation ID>. Keep false unless the bank confirms custom references are accepted
# (the bank's own QR has no tr). The donation ID is always sent in the payment note (tn).
UPI_IS_MERCHANT=false
MIN_DONATION_AMOUNT=10
# Keep at 4 or below on Vercel (request body limit is 4.5 MB).
MAX_UPLOAD_MB=4

# ── Screenshot storage ──────────────────────────────────────────
# local = files in LOCAL_STORAGE_DIR on this server (dev, or a VPS with a disk).
# r2    = private Cloudflare R2 bucket (required on Vercel).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.private-uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Gmail: sends confirmation emails AND reads bank payment alerts ─
# Google Account → Security → 2-Step Verification → App passwords → create one.
# The bank must email (or forward) its "amount credited" alerts to this inbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who approves payments. GMAIL_USER (the UPI owner's inbox) always gets the "please approve"
# email with the one-click approve link, and the "approved" notice; add admins here, comma-separated.
# The link uses NEXT_PUBLIC_APP_URL.
APPROVAL_EMAILS=
# false (recommended): the donor is emailed only after the UPI owner or an admin approves.
# true: a matching bank "amount credited" email confirms the donation automatically.
AUTO_CONFIRM_BANK_EMAILS=false
# Optional overrides (defaults cover the major Indian banks):
# BANK_ALERT_DOMAINS=hdfcbank.net,icicibank.com,axisbank.com,kotak.com,sbi.co.in
# AUTO_MATCH_WINDOW_MINUTES=120
# BANK_SYNC_INTERVAL_SECONDS=15

# ── Email (Resend, optional alternative to Gmail for sending) ───
RESEND_API_KEY=
EMAIL_FROM="Namo Bhagwate Vasudevaya Trust <donations@your-domain.org>"
EMAIL_REPLY_TO=
NGO_NAME="Namo Bhagwate Vasudevaya Trust"

# ── Jobs ────────────────────────────────────────────────────────
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ── Public ──────────────────────────────────────────────────────
# Public site address, used for the approve link in approval emails. On Vercel it can be
# left unset (the production domain is used automatically).
NEXT_PUBLIC_APP_URL=https://nano-bhagvate.vercel.app
